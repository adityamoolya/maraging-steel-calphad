PARAMETER G(A3,FE,TI:VA;0)  298.15  -10000+15*T;  6000.0  N REF0 !

$ Ni-Ti binary (Bellen et al. [56])
PARAMETER G(A3,NI,TI:VA;0)  298.15  -20000;  6000.0  N REF56 !

$ -------------------------------------------------------
$ C14 (LAVES PHASE, Fe2Ti - 3 SUBLATTICE)
$ Model: (Fe,Ni,Ti)1 (Fe,Ni,Ti)1.5 (Fe,Ni,Ti)0.5
$ Stoichiometry of stable compound: Ti:Fe:Fe = 1:1.5:0.5
$ -------------------------------------------------------

$ --- Fe-Ti binary end-members ---

$ Stable compound Fe2Ti
PARAMETER G(C14,TI:FE:FE)  298.15  +GTIFE2#;  6000.0  N REF37 !

$ Wagner-Schottky reverse end-member (Eq.15)
PARAMETER G(C14,FE:TI:TI)  298.15
  +3*GHSERFE#+3*GHSERTI#+6*DGLAV#-GTIFE2#;
  6000.0  N REF37 !

$ New 3-sublattice end-members from mechanical mixing (Eq.14, this work)
PARAMETER G(C14,FE:TI:FE)  298.15  +1.5*GLAVTI#+1.5*GLAVFE#;  6000.0  N REF0 !
PARAMETER G(C14,TI:TI:FE)  298.15  +2.5*GLAVTI#+0.5*GLAVFE#;  6000.0  N REF0 !
PARAMETER G(C14,FE:FE:TI)  298.15  +0.5*GLAVTI#+2.5*GLAVFE#;  6000.0  N REF0 !
PARAMETER G(C14,TI:FE:TI)  298.15  +1.5*GLAVTI#+1.5*GLAVFE#;  6000.0  N REF0 !

$ --- Fe-Ti C14 interaction parameters (Eq.16, from Kumar [37] with modifications) ---
$ 1st sublattice mixing (Fe,Ti):Fe:Fe - unchanged from 2-sublattice description
PARAMETER G(C14,FE,TI:FE:FE;0)  298.15  +3177;  6000.0  N REF37 !
PARAMETER G(C14,FE,TI:TI:TI;0)  298.15  +3177;  6000.0  N REF37 !

$ 2nd sublattice mixing (this work, Eq.16 constraints applied)
PARAMETER G(C14,FE:FE,TI:FE;0)  298.15  +18000;  6000.0  N REF0 !
PARAMETER G(C14,TI:FE,TI:FE;0)  298.15  +18000;  6000.0  N REF0 !
PARAMETER G(C14,FE:FE,TI:TI;0)  298.15  +18000;  6000.0  N REF0 !
PARAMETER G(C14,TI:FE,TI:TI;0)  298.15  +18000;  6000.0  N REF0 !

$ 3rd sublattice mixing (this work, Eq.16 constraints applied)
PARAMETER G(C14,FE:FE:FE,TI;0)  298.15  +6000;  6000.0  N REF0 !
PARAMETER G(C14,TI:FE:FE,TI;0)  298.15  +6000;  6000.0  N REF0 !
PARAMETER G(C14,FE:TI:FE,TI;0)  298.15  +6000;  6000.0  N REF0 !
PARAMETER G(C14,TI:TI:FE,TI;0)  298.15  +6000;  6000.0  N REF0 !

$ --- Ni-Fe binary C14 end-members (Table A.2, this work) ---
PARAMETER G(C14,NI:FE:FE)  298.15  -15000+GLAVNI#+2*GLAVFE#;  6000.0  N REF0 !
PARAMETER G(C14,FE:NI:FE)  298.15  +1.5*GLAVFE#+1.5*GLAVNI#;  6000.0  N REF0 !
PARAMETER G(C14,NI:NI:FE)  298.15  +0.5*GLAVFE#+2.5*GLAVNI#;  6000.0  N REF0 !
PARAMETER G(C14,FE:FE:NI)  298.15  +2.5*GLAVFE#+0.5*GLAVNI#;  6000.0  N REF0 !
PARAMETER G(C14,NI:FE:NI)  298.15  +1.5*GLAVFE#+1.5*GLAVNI#;  6000.0  N REF0 !
PARAMETER G(C14,FE:NI:NI)  298.15  -29828+GLAVFE#+2*GLAVNI#;  6000.0  N REF0 !

$ --- Ni-Ti binary C14 end-members (Table A.4, this work) ---
PARAMETER G(C14,TI:NI:NI)  298.15
  +GHSERTI#+2*GHSERNI#+3*GFTINI2#;
  6000.0  N REF0 !

$ GFTINI2 function
FUNCTION GFTINI2  298.15  -27132.753;  6000.0  N REF0 !

PARAMETER G(C14,NI:TI:TI)  298.15
  +GLAVNI#+2*GLAVTI#+3*DGLAV#-3*GFTINI2#;
  6000.0  N REF0 !
PARAMETER G(C14,TI:TI:NI)  298.15  +2.5*GLAVTI#+0.5*GLAVNI#;  6000.0  N REF0 !
PARAMETER G(C14,NI:NI:TI)  298.15  +0.5*GLAVTI#+2.5*GLAVNI#;  6000.0  N REF0 !
PARAMETER G(C14,TI:NI:TI)  298.15  +1.5*GLAVTI#+1.5*GLAVNI#;  6000.0  N REF0 !

$ --- Fe-Ni-Ti ternary C14 parameters (Table A.5, this work) ---
PARAMETER G(C14,TI:FE:NI)  298.15
  -92832+2.646*T+GLAVTI#+1.5*GLAVFE#+0.5*GLAVNI#;
  6000.0  N REF0 !
PARAMETER G(C14,FE:TI:NI)  298.15
  +GLAVFE#+1.5*GLAVTI#+0.5*GLAVNI#;
  6000.0  N REF0 !
PARAMETER G(C14,NI:FE:TI)  298.15
  +GLAVNI#+1.5*GLAVFE#+0.5*GLAVTI#;
  6000.0  N REF0 !
PARAMETER G(C14,TI:FE:TI)  298.15  +1.5*GLAVTI#+1.5*GLAVFE#;  6000.0  N REF0 !
PARAMETER G(C14,FE:NI:TI)  298.15
  +GLAVFE#+1.5*GLAVNI#+0.5*GLAVTI#;
  6000.0  N REF0 !
PARAMETER G(C14,TI:NI:FE)  298.15
  -97167+7.11*T+GLAVTI#+1.5*GLAVNI#+0.5*GLAVFE#;
  6000.0  N REF0 !
PARAMETER G(C14,NI:TI:FE)  298.15
  +GLAVNI#+1.5*GLAVTI#+0.5*GLAVFE#;
  6000.0  N REF0 !

$ C15 (metastable Laves) and C36 (metastable Laves) - from [16]
$ Included for quaternary Al-Fe-Ni-Ti compatibility
PHASE C15  %  2  1.0  2.0  !
CONSTITUENT C15  :FE,NI,TI:FE,NI,TI:  !
PARAMETER G(C15,NI:FE)  298.15  +GLAVNI#+2*GLAVFE#;  6000.0  N REF16 !
PARAMETER G(C15,FE:NI)  298.15  +GLAVFE#+2*GLAVNI#;  6000.0  N REF16 !

PHASE C36  %  2  1.0  2.0  !
CONSTITUENT C36  :FE,NI,TI:FE,NI,TI:  !
PARAMETER G(C36,NI:FE)  298.15  +GLAVNI#+2*GLAVFE#;  6000.0  N REF16 !
PARAMETER G(C36,FE:NI)  298.15  +GLAVFE#+2*GLAVNI#;  6000.0  N REF16 !

