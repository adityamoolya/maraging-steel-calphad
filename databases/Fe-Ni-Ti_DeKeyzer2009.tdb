PARAMETER G(FCC4,TI:NI:NI:NI:VA)  298.15  +3*UNITI#;  6000.0  N REF79 !

$ Ni-Ti FCC4 interaction on same sublattice (Dupin-Sundman [79])
$ Represents interaction between Ni and Ti on each sublattice
PARAMETER G(FCC4,NI,TI:*:*:*:VA)  298.15  -5408;  6000.0  N REF79 !

$ -------------------------------------------------------
$ A2 (DISORDERED BCC) PHASE
$ -------------------------------------------------------

$ Pure element end-members
PARAMETER G(A2,FE:VA)  298.15  +GBCCFE#;  6000.0  N REF77 !
PARAMETER G(A2,NI:VA)  298.15  +GBCCNI#;  6000.0  N REF77 !
PARAMETER G(A2,TI:VA)  298.15  +GBCCTI#;  6000.0  N REF77 !

$ Magnetic parameters (pure elements in BCC)
PARAMETER TC(A2,FE:VA)    298.15  1043;   6000.0  N REF77 !
PARAMETER BMAGN(A2,FE:VA) 298.15  2.22;   6000.0  N REF77 !
PARAMETER TC(A2,NI:VA)    298.15  575;    6000.0  N REF77 !
PARAMETER BMAGN(A2,NI:VA) 298.15  0.85;   6000.0  N REF77 !

$ Fe-Ni binary (Cacciamani-Dinsdale [16])
PARAMETER G(A2,FE,NI:VA;0)   298.15  -956.63-1.28726*T;   6000.0  N REF16 !
PARAMETER G(A2,FE,NI:VA;1)   298.15  +3789.03-1.92912*T;  6000.0  N REF16 !
PARAMETER TC(A2,FE,NI:VA;0)  298.15  -1000;  6000.0  N REF16 !
PARAMETER TC(A2,FE,NI:VA;1)  298.15  +1500;  6000.0  N REF16 !
PARAMETER BMAGN(A2,FE,NI:VA;0)  298.15  1.0;  6000.0  N REF16 !
PARAMETER BMAGN(A2,FE,NI:VA;1)  298.15  1.6;  6000.0  N REF16 !

$ Fe-Ti binary (Hari Kumar [37])
PARAMETER G(A2,FE,TI:VA;0)   298.15  -68448+23.825*T;  6000.0  N REF37 !
PARAMETER G(A2,FE,TI:VA;1)   298.15  +5467-5.083*T;    6000.0  N REF37 !
PARAMETER G(A2,FE,TI:VA;2)   298.15  +25262-15.83*T;   6000.0  N REF37 !
PARAMETER TC(A2,FE,TI:VA;0)  298.15  637.79;  6000.0  N REF37 !

$ Ni-Ti binary (Bellen et al. [56])
PARAMETER G(A2,NI,TI:VA;0)   298.15  -97427+12.112*T;  6000.0  N REF56 !
PARAMETER G(A2,NI,TI:VA;1)   298.15  -32315;           6000.0  N REF56 !
PARAMETER TC(A2,NI,TI:VA;0)  298.15  -575;   6000.0  N REF56 !
PARAMETER BMAGN(A2,NI,TI:VA;0)  298.15  -0.85;  6000.0  N REF56 !

$ -------------------------------------------------------
$ BCC2 (2-SUBLATTICE ORDERED BCC, B2)
$ Order-disorder: Gm = G_dis(A2) + delta_G_ord(BCC2)
$ Sublattice symmetry: G(A:B) = G(B:A), L(A,C:B) = L(B:A,C) [Eqs.12-13]
$ -------------------------------------------------------

$ Fe-Ti B2 ordered end-member (Hari Kumar [37])
$ G(BCC2,FETI) represents all permutations of Fe and Ti on sublattices
PARAMETER G(BCC2,FE:TI:VA)  298.15
  +76218-46.685*T+8.663*T*LN(T)-7.151E-3*T**2+1.121169E-6*T**3;
  6000.0  N REF37 !
PARAMETER G(BCC2,TI:FE:VA)  298.15
  +76218-46.685*T+8.663*T*LN(T)-7.151E-3*T**2+1.121169E-6*T**3;
  6000.0  N REF37 !

$ TC for FeTi B2
PARAMETER TC(BCC2,FE:TI:VA)  298.15  -1325;  6000.0  N REF37 !
PARAMETER TC(BCC2,TI:FE:VA)  298.15  -1325;  6000.0  N REF37 !

$ B2 Fe-Ti interaction parameters (symmetric: [37])
PARAMETER G(BCC2,FE,TI:FE:VA;0)  298.15  -10971;  6000.0  N REF37 !
PARAMETER G(BCC2,FE:FE,TI:VA;0)  298.15  -10971;  6000.0  N REF37 !
PARAMETER G(BCC2,FE,TI:FE:VA;1)  298.15  -13764;  6000.0  N REF37 !
PARAMETER G(BCC2,FE:FE,TI:VA;1)  298.15  -13764;  6000.0  N REF37 !
PARAMETER G(BCC2,TI:FE,TI:VA;0)  298.15  -6097;   6000.0  N REF37 !
PARAMETER G(BCC2,FE,TI:TI:VA;0)  298.15  -6097;   6000.0  N REF37 !
PARAMETER G(BCC2,TI:FE,TI:VA;1)  298.15  +12256;  6000.0  N REF37 !
PARAMETER G(BCC2,FE,TI:TI:VA;1)  298.15  +12256;  6000.0  N REF37 !

$ Ni-Ti B2 ordered end-member (Bellen et al. [56])
PARAMETER G(BCC2,NI:TI:VA)  298.15  -33193.7+10.284*T;  6000.0  N REF56 !
PARAMETER G(BCC2,TI:NI:VA)  298.15  -33193.7+10.284*T;  6000.0  N REF56 !

$ B2 Ni-Ti interaction parameters (symmetric: [56])
PARAMETER G(BCC2,TI:NI,TI:VA;0)  298.15  +60723.7-15.4024*T;  6000.0  N REF56 !
PARAMETER G(BCC2,NI,TI:TI:VA;0)  298.15  +60723.7-15.4024*T;  6000.0  N REF56 !
PARAMETER G(BCC2,NI,TI:NI:VA;0)  298.15  -55288.8+25.4416*T;  6000.0  N REF56 !
PARAMETER G(BCC2,NI:NI,TI:VA;0)  298.15  -55288.8+25.4416*T;  6000.0  N REF56 !
PARAMETER G(BCC2,NI,TI:NI:VA;2)  298.15  +6010.11+3.95974*T;  6000.0  N REF56 !
PARAMETER G(BCC2,NI:NI,TI:VA;2)  298.15  +6010.11+3.95974*T;  6000.0  N REF56 !

$ Fe-Ni B2 (Cacciamani-Dinsdale [16] - set to zero, both permutations)
PARAMETER G(BCC2,FE:NI:VA)  298.15  0;  6000.0  N REF16 !
PARAMETER G(BCC2,NI:FE:VA)  298.15  0;  6000.0  N REF16 !

$ Fe-Ni-Ti ternary BCC2 interaction parameters (this work)
PARAMETER G(BCC2,TI:FE,NI:VA;0)  298.15  +11774;  6000.0  N REF0 !
PARAMETER G(BCC2,FE,NI:TI:VA;0)  298.15  +11774;  6000.0  N REF0 !

$ -------------------------------------------------------
$ A3 (HCP) PHASE
$ -------------------------------------------------------

$ Pure element end-members
PARAMETER G(A3,FE:VA)  298.15  +GHCPFE#;  6000.0  N REF77 !
PARAMETER G(A3,NI:VA)  298.15  +GHCPNI#;  6000.0  N REF77 !
PARAMETER G(A3,TI:VA)  298.15  +GHCPTI#;  6000.0  N REF77 !

$ Fe-Ni binary (Cacciamani-Dinsdale [16])
PARAMETER G(A3,FE,NI:VA;0)  298.15  -12054.355+3.27413*T;  6000.0  N REF16 !
PARAMETER G(A3,FE,NI:VA;1)  298.15  +11082-4.45077*T;      6000.0  N REF16 !
PARAMETER G(A3,FE,NI:VA;2)  298.15  -725.8;                6000.0  N REF16 !

