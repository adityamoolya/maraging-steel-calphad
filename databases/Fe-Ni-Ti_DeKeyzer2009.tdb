$==============================================================================
$ Fe-Ni-Ti Thermodynamic Database
$ Based on: De Keyzer J., Cacciamani G., Dupin N., Wollants P.
$ "Thermodynamic modeling and optimization of the Fe-Ni-Ti system"
$ CALPHAD 33 (2009) 109-123
$ DOI: 10.1016/j.calphad.2008.10.003
$
$ Binary sub-systems:
$   Fe-Ni : Cacciamani G., Dinsdale A. (personal communication, COST 535)
$   Fe-Ti : Kumar K.C. Hari, XXVIII CALPHAD meeting, Grenoble 1999 [Ref.37]
$            (modified Laves phase + hcp sign fix - this work)
$   Ni-Ti : Bellen P., Hari Kumar K.C., Wollants P., Z.Metall. 87 (1996) [Ref.56]
$            (Ni3Ti lattice stability + fcc reassessment - this work)
$
$ Phases included:
$   LIQUID   : (Fe,Ni,Ti)
$   A1/FCC4  : disordered fcc (Fe,Ni,Ti)  +  4-sublattice L12/L10 ordering
$   A2/BCC2  : disordered bcc (Fe,Ni,Ti)  +  2-sublattice B2 ordering
$   A3       : hcp  (Fe,Ni,Ti)
$   C14      : Laves phase Fe2Ti, 3-sublattice (Fe,Ni,Ti)1(Fe,Ni,Ti)1.5(Fe,Ni,Ti)0.5
$   NI3TI    : D024 Ni3Ti, 2-sublattice (Fe,Ni,Ti)3(Fe,Ni,Ti)1
$   NITI2    : E93  NiTi2, 2-sublattice (Fe,Ni,Ti)2(Fe,Ni,Ti)1
$
$ Notes:
$   - Magnetic contributions (TC, BMAGN) follow Hillert-Jarl/Inden formalism
$   - BCC2 vacancies included in both sublattices for B2 triple-defect description
$   - DGLAV = 5000 J/mol is the destabilisation energy for Laves end-members
$   - GDHC* = 0.5*GHCP* + 0.5*GFCC* (dhcp lattice stability estimate, this work)
$   - All energies in J/mol; T in Kelvin
$==============================================================================

$ ============================================================
$ ELEMENT DECLARATIONS
$ ============================================================
ELEMENT /-   ELECTRON_GAS    0.0000E+00  0.0000E+00  0.0000E+00 !
ELEMENT VA   VACUUM          0.0000E+00  0.0000E+00  0.0000E+00 !
ELEMENT FE   BCC_A2          5.5845E+01  4.4890E+03  2.7280E+01 !
ELEMENT NI   FCC_A1          5.8690E+01  4.7870E+03  2.9796E+01 !
ELEMENT TI   HCP_A3          4.7880E+01  4.8240E+03  3.0648E+01 !

$ ============================================================
$ SPECIES
$ ============================================================
SPECIES FE   FE1 !
SPECIES NI   NI1 !
SPECIES TI   TI1 !
SPECIES VA   VA  !

$ ============================================================
$ PHASE DECLARATIONS
$ ============================================================
$ Liquid solution
PHASE LIQUID  %  1  1.0  !
CONSTITUENT LIQUID  :FE,NI,TI:  !

$ Disordered FCC (A1) - single sublattice (disordered part of FCC4)
PHASE A1  %  2  1.0  1.0  !
CONSTITUENT A1  :FE,NI,TI:VA:  !

$ 4-sublattice ordered FCC (L12/L10) - FCC4
$ Ordering of A1; disordered contribution comes from A1
PHASE FCC4  %B  5  0.25  0.25  0.25  0.25  1.0  !
CONSTITUENT FCC4  :FE,NI,TI:FE,NI,TI:FE,NI,TI:FE,NI,TI:VA:  !

$ Disordered BCC (A2) - single sublattice (disordered part of BCC2)
PHASE A2  %  2  1.0  1.0  !
CONSTITUENT A2  :FE,NI,TI:VA:  !

$ 2-sublattice ordered BCC (B2) with vacancies - BCC2
$ Ordering of A2
PHASE BCC2  %B  3  0.5  0.5  1.0  !
CONSTITUENT BCC2  :FE,NI,TI,VA:FE,NI,TI,VA:VA:  !

$ HCP (A3) - alpha-Ti, alpha-Fe (metastable)
PHASE A3  %  2  1.0  0.5  !
CONSTITUENT A3  :FE,NI,TI:VA:  !

$ C14 Laves phase - 3 sublattice model
$ (Fe,Ni,Ti)1 (Fe,Ni,Ti)1.5 (Fe,Ni,Ti)0.5
PHASE C14  %  3  1.0  1.5  0.5  !
CONSTITUENT C14  :FE,NI,TI:FE,NI,TI:FE,NI,TI:  !

$ Ni3Ti - D024 structure, 2 sublattices
PHASE NI3TI  %  2  3.0  1.0  !
CONSTITUENT NI3TI  :FE,NI,TI:FE,NI,TI:  !

$ NiTi2 - E93 structure, 2 sublattices
PHASE NITI2  %  2  2.0  1.0  !
CONSTITUENT NITI2  :FE,NI,TI:FE,NI,TI:  !

$ ============================================================
$ FUNCTIONS - Pure element lattice stabilities (SGTE, Dinsdale 1991)
$ ============================================================

$ --- IRON ---
FUNCTION GHSERFE  298.15
  +1225.7+124.134*T-23.5143*T*LN(T)-4.39752E-3*T**2
  -5.8927E-8*T**3+77359*T**(-1);
  1811.0  Y
  -25383.581+299.31255*T-46*T*LN(T)+2.29603E+31*T**(-9);
  6000.0  N !

$ --- NICKEL ---
FUNCTION GHSERNI  298.15
  -5179.159+117.854*T-22.096*T*LN(T)-4.8407E-3*T**2;
  1728.0  Y
  -27840.655+279.135*T-31*T*LN(T)+1.12754E+31*T**(-9);
  6000.0  N !

$ --- TITANIUM ---
FUNCTION GHSERTI  298.15
  -8059.921+133.615208*T-23.9933*T*LN(T)-4.777975E-3*T**2
  +1.06716E-7*T**3+72636*T**(-1);
  900.0  Y
  -7811.815+132.988068*T-23.9887*T*LN(T)-4.2033E-3*T**2
  -9.0876E-8*T**3+42680*T**(-1);
  1155.0  Y
  +908.837+66.976538*T-14.9466*T*LN(T)-8.1465E-3*T**2
  +2.02715E-7*T**3-1477660*T**(-1);
  1941.0  Y
  -124526.786+638.806871*T-87.2182461*T*LN(T)+8.204849E-3*T**2
  -3.04747E-7*T**3+36699805*T**(-1);
  6000.0  N !

$ ============================================================
$ FUNCTIONS - Structural energy differences (metastable references)
$ ============================================================

$ BCC references
FUNCTION GBCCFE  298.15  +GHSERFE#;  6000.0  N !
FUNCTION GBCCNI  298.15  +8715.084-3.556*T+GHSERNI#;  6000.0  N !
FUNCTION GBCCTI  298.15
  -1272.064+134.71418*T-25.5768*T*LN(T)-6.63845E-4*T**2
  -2.78803E-7*T**3+7208*T**(-1);
  1155.0  Y
  +6667.385+105.366379*T-22.3771*T*LN(T)+1.21707E-3*T**2
  -8.4534E-7*T**3-2002750*T**(-1);
  1941.0  Y
  +26483.26-182.426471*T+19.0900905*T*LN(T)-2.200832E-2*T**2
  +1.228863E-6*T**3+1400501*T**(-1);
  6000.0  N !

$ FCC references
FUNCTION GFCCFE  298.15
  -236.7+132.416*T-24.6643*T*LN(T)-3.75752E-3*T**2
  -5.8927E-8*T**3+77359*T**(-1);
  1811.0  Y
  -27097.3963+300.252559*T-46*T*LN(T)+2.78854E+31*T**(-9);
  6000.0  N !
FUNCTION GFCCNI  298.15  +GHSERNI#;  6000.0  N !
FUNCTION GFCCTI  298.15  +6000-0.1*T+GHSERTI#;  6000.0  N !

$ HCP references
FUNCTION GHCPFE  298.15
  -2480.08+136.725*T-24.6643*T*LN(T)-3.75752E-3*T**2
  -5.8927E-8*T**3+77359*T**(-1);
  1811.0  Y
  -29340.776+304.561559*T-46*T*LN(T)+2.78854E+31*T**(-9);
  6000.0  N !
FUNCTION GHCPNI  298.15  +1046+1.255*T+GHSERNI#;  6000.0  N !
FUNCTION GHCPTI  298.15  +GHSERTI#;  6000.0  N !

$ DHCP references (this work: 0.5*GHCP + 0.5*GFCC)
FUNCTION GDHCFE  298.15  +0.5*GHCPFE#+0.5*GFCCFE#;  6000.0  N !
FUNCTION GDHCNI  298.15  +0.5*GHCPNI#+0.5*GFCCNI#;  6000.0  N !
FUNCTION GDHCTI  298.15  +0.5*GHCPTI#+0.5*GFCCTI#;  6000.0  N !

$ Laves phase destabilisation penalty
FUNCTION DGLAV   298.15  +5000;  6000.0  N !

$ Laves structure references (pure elements in Laves structure)
FUNCTION GLAVFE  298.15  +GHSERFE#+DGLAV#;  6000.0  N !
FUNCTION GLAVNI  298.15  +GHSERNI#+DGLAV#;  6000.0  N !
FUNCTION GLAVTI  298.15  +GHSERTI#+DGLAV#;  6000.0  N !

$ Stable intermetallic Gibbs energy functions
$ Fe2Ti (C14 Laves) - from Kumar [37]
FUNCTION GTIFE2  298.15
  -78603+349.9675*T-64.502*T*LN(T)-2.41491E-2*T**2
  +3.936825E-6*T**3+7620*T**(-1);
  6000.0  N !

$ NiTi2 (E93) sub-function - from Ansara [69]
FUNCTION GTI2NI  298.15
  +0.333333*GHSERNI#+0.666667*GHSERTI#
  -27514.218+2.85345219*T;
  6000.0  N !

$ NiTi2 FeTi2-like end-member sub-function (this work)
FUNCTION GFTI2FE  298.15  -17202+1.2*T;  6000.0  N !

$ FCC4 interaction sub-functions
$ Fe-Ti FCC4 interaction (Ansara, personal comm. 1995 [78])
FUNCTION UFETI   298.15  -12274+8.59*T;  6000.0  N !

$ Ni-Ti FCC4 interaction (Dupin, Sundman [79])
FUNCTION UNITI   298.15  -8562+4.1*T;  6000.0  N !

$ ============================================================
$ THERMODYNAMIC PARAMETERS
$ ============================================================

$ -------------------------------------------------------
$ LIQUID PHASE
$ -------------------------------------------------------

$ Fe-Ni binary (Cacciamani-Dinsdale [16])
PARAMETER G(LIQUID,FE,NI;0)   298.15  -18782+3.7011*T;  6000.0  N REF16 !
PARAMETER G(LIQUID,FE,NI;1)   298.15  +12308.6-2.75998*T;  6000.0  N REF16 !
PARAMETER G(LIQUID,FE,NI;2)   298.15  +4457-4.1536*T;  6000.0  N REF16 !

$ Fe-Ti binary (Hari Kumar [37])
PARAMETER G(LIQUID,FE,TI;0)   298.15  -76247+17.845*T;  6000.0  N REF37 !
PARAMETER G(LIQUID,FE,TI;1)   298.15  +7990-6.059*T;  6000.0  N REF37 !
PARAMETER G(LIQUID,FE,TI;2)   298.15  +4345-2.844*T;  6000.0  N REF37 !

$ Ni-Ti binary (Bellen et al. [56])
PARAMETER G(LIQUID,NI,TI;0)   298.15  -153707.39+34.859449*T;  6000.0  N REF56 !
PARAMETER G(LIQUID,NI,TI;1)   298.15  -81824.755+25.809901*T;  6000.0  N REF56 !
PARAMETER G(LIQUID,NI,TI;2)   298.15  -10.077897*T;  6000.0  N REF56 !

$ Fe-Ni-Ti ternary (this work)
PARAMETER G(LIQUID,FE,NI,TI;0)  298.15  +17749;  6000.0  N REF0 !

$ -------------------------------------------------------
$ A1 (DISORDERED FCC) PHASE
$ -------------------------------------------------------

