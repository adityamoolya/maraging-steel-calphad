&CONTROL
  calculation  = 'scf',
  prefix       = 'ni_bulk',
  pseudo_dir   = './pseudo/',
  outdir       = './out/'
/
&SYSTEM
  ibrav       = 2,            ! 2 means FCC lattice
  celldm(1)   = 6.659,        ! Lattice parameter for Ni
  nat         = 1,            ! Number of atoms
  ntyp        = 1,            ! Number of types of atoms
  ecutwfc     = 40.0,         ! Math precision
  ecutrho     = 320.0,
  occupations = 'smearing',   ! Smearing is required for metals
  smearing    = 'marzari-vanderbilt',
  degauss     = 0.02
/
&ELECTRONS
  conv_thr    = 1.0d-8
/
ATOMIC_SPECIES
  Ni  58.6934  Ni.pbe-nd-rrkjus.UPF
ATOMIC_POSITIONS (alat)
  Ni  0.0  0.0  0.0
K_POINTS (automatic)
  8 8 8   0 0 0
