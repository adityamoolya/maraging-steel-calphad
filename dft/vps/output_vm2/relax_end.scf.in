&CONTROL
  calculation = 'relax'
  prefix = 'fe15_ni1_end'
  outdir = './outdir'
  pseudo_dir = '../../pseudo/'
/
&SYSTEM
  ibrav = 1
  celldm(1) = 10.832
  nat = 15
  ntyp = 2
  ecutwfc = 45
  ecutrho = 360
  occupations = 'smearing'
  smearing = 'm-v'
  degauss = 0.02
  nspin = 2
  starting_magnetization(1) = 0.5
  starting_magnetization(2) = 0.0
/
&ELECTRONS
  electron_maxstep = 300
  conv_thr = 1.0d-6
  mixing_beta = 0.1
  mixing_mode = 'local-TF'
  diagonalization = 'david'
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  Fe  55.845  Fe.pbe-spn-rrkjus_psl.1.0.0.UPF
  Ni  58.693  Ni.pbe-spn-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS (crystal)
  Ni 0.000000 0.000000 0.000000
  Fe 0.500000 0.000000 0.000000
  Fe 0.000000 0.500000 0.000000
  Fe 0.500000 0.500000 0.000000
  Fe 0.000000 0.000000 0.500000
  Fe 0.500000 0.000000 0.500000
  Fe 0.000000 0.500000 0.500000
  Fe 0.500000 0.500000 0.500000
  Fe 0.750000 0.250000 0.250000
  Fe 0.250000 0.750000 0.250000
  Fe 0.750000 0.750000 0.250000
  Fe 0.250000 0.250000 0.750000
  Fe 0.750000 0.250000 0.750000
  Fe 0.250000 0.750000 0.750000
  Fe 0.750000 0.750000 0.750000
K_POINTS (automatic)
  4 4 4 0 0 0
